# Cliente (Vite)
VITE_API_URL=http://localhost:3001

# Analytics (opcional)
# VITE_GA4_ID=G-XXXXXXXXXX
# VITE_META_PIXEL_ID=000000000000000

# Servidor (Express)
PORT=3001
SITE_URL=http://localhost:5173

# ⬇️ Mercado Pago — creá tus credenciales en https://www.mercadopago.com.ar/developers
# Access Token (server, desde el panel "Credenciales de producción")
MERCADOPAGO_ACCESS_TOKEN=TEST-0000000000000000000000000000000000-000000-000000
# Moneda de los precios (ARS, USD, EUR, BRL…)
MERCADOPAGO_CURRENCY=ARS

# Token para ver los pedidos recibidos: GET /api/orders con "Authorization: Bearer <token>"
ADMIN_TOKEN=cambiar-admin-token

# URL que recibe un POST cuando un pedido se marca como PAGADO (Zapier/n8n/WhatsApp API/Slack)
# NOTIFY_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxxxx

# ⬇️ WhatsApp Cloud API (chatbot automático en WhatsApp) — https://developers.facebook.com
WA_ACCESS_TOKEN=EAA...TU_TOKEN_DE_META
WA_PHONE_ID=TU_NUMBER_ID
WA_VERIFY_TOKEN=un-token-secreto-tuyo
# WA_APP_SECRET=el-app-secret-de-la-app-de-meta
# WA_GRAPH_VERSION=v22.0

# Número del dueño para recibir aviso cuando alguien PAGA un pedido (formato internacional sin +, ej: 51936028001)
WA_OWNER_NUMBER=51936028001
# Template de WhatsApp aprobado para el aviso al dueño (recomendado). Params: [n° pedido, productos, total]
# WA_ORDER_TEMPLATE=aviso_pedido

# Datos del negocio usados por el bot en WhatsApp (si se dejan vacíos usa los de la web)
# BUSINESS_CURRENCY=$
# BUSINESS_ADDRESS=Av. Corrientes 1234, Buenos Aires
# BUSINESS_HOURS=Lun a Sáb de 9 a 20 h y Domingos de 10 a 18 h
# BUSINESS_FREE_DELIVERY_FROM=50

# ⬇️ Persistencia de pedidos
# En Vercel usa KV (no hay disco permanente). Crear KV en el dashboard y pegar:
# KV_REST_API_URL=https://...upstash.io
# KV_REST_API_TOKEN=AX...
# KV_ORDERS_KEY=dda:orders
